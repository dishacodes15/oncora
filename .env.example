# Copy this to .env and fill in real values. Never commit .env itself.

# Get a free key at https://open.fda.gov/apis/authentication/
# Free tier without a key: 40 req/min, 1000 req/day (per IP)
# Free tier with a key:   240 req/min, 120,000 req/day
OPENFDA_API_KEY=

# Optional overrides (defaults shown)
SPACY_MODEL=en_core_sci_sm
DRUG_VOCAB_PATH=data/drug_vocab.json
INTERACTIONS_DB_PATH=data/interactions.db
